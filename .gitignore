# Public draft allowlist. Local research, context and generated output stay private.
/*
!/.gitignore
!/.prettierignore
!/.prettierrc.json
!/README.md
!/SPEC.md
!/EXAMPLES.md
!/FUTURE.md
!/CONTRIBUTING.md
!/LICENSE
!/package.json
!/bun.lock
!/tsconfig.json
!/tsconfig.package.json
!/.github/
!/docs/
/docs/*
!/docs/semantics.md
!/docs/inspirations.md
!/docs/implementation-status.md
!/docs/publication.md
!/guidelines/
/guidelines/*
!/guidelines/implementation.md
!/guidelines/streaming.md
!/guidelines/security.md
!/guidelines/nesting.md
!/guidelines/vendor-extensions.md
!/guidelines/host-data.md
!/scripts/
/scripts/*
!/scripts/artifacts.ts
!/scripts/build.ts
!/scripts/build-package.ts
!/scripts/check-package.ts
!/scripts/check-site.ts
!/scripts/notices.ts
!/scripts/serve.ts
!/scripts/site-config.ts
!/scripts/spec-page.ts
!/site/
/site/*
!/site/index.html
!/site/style.css
!/site/future.md
!/site/media/
!/src/
/src/*
!/src/README.md
!/src/actions.ts
!/src/activity.ts
!/src/app.ts
!/src/baseline.ts
!/src/delimiters.ts
!/src/diagrams.ts
!/src/diff.ts
!/src/disclosures.ts
!/src/examples.ts
!/src/html-source.ts
!/src/index.ts
!/src/parser.ts
!/src/reconcile.ts
!/src/renderer.ts
!/src/streaming.ts
!/src/styles.css
!/src/timers.ts
!/src/types.ts
!/tests/
/tests/*
!/tests/renderer.test.ts
!/tests/timers.test.ts
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/grammar.json
